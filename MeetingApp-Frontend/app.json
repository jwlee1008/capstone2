{
  "expo": {
    "name": "Meno",
    "slug": "meno",
    "version": "1.0.2",
    "scheme": "meno",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "web": {
      "bundler": "metro"
    },
    "android": {
      "package": "com.jwlee.meno",
      "versionCode": 3,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "meno"
            },
            {
              "scheme": "meetflow"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      "expo-audio",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "2e242e7d-da3a-4488-b369-2438b26bda11"
      }
    },
    "owner": "jwlee10088"
  }
}
