# npm start / direct Expo
# Expo Go 실기기는 비워두면 Expo 개발 서버 LAN IP 기준으로 http://<LAN-IP>:8080 을 자동 사용합니다.
# 직접 지정해야 하면 휴대폰에서 접근 가능한 백엔드 주소를 넣으세요.
# EXPO_PUBLIC_API_BASE_URL=http://192.168.0.10:8080

# Expo Go OAuth callback values are printed by npm start.
# Set these on the backend process, not in the frontend bundle:
# OAUTH_BASE_URL=https://your-https-tunnel.example
# NOTION_LINK_DEEP_LINK=exp://192.168.0.10:8081/--/notion/link
# APP_NOTION_LINK_DEEP_LINK=exp://192.168.0.10:8081/--/notion/link
# APP_OAUTH_MOBILE_NOTION_LOGIN_DEEP_LINK=exp://192.168.0.10:8081/--/oauth/notion
# APP_OAUTH_MOBILE_GOOGLE_DEEP_LINK=exp://192.168.0.10:8081/--/oauth/google

# npm run web proxy
BACKEND_ORIGIN=http://localhost:8080
PROXY_PORT=8081
EXPO_PORT=8082

# EAS preview APK
# This value is baked into the APK at build time. Keep it in sync with eas.json.
# EXPO_PUBLIC_API_BASE_URL=https://meno-app.shop

# Standalone APK OAuth deep links for the backend process:
# APP_OAUTH_MOBILE_GOOGLE_DEEP_LINK=meno://oauth/google
# APP_OAUTH_MOBILE_NOTION_LOGIN_DEEP_LINK=meno://oauth/notion
# NOTION_LINK_DEEP_LINK=meno://notion/link
# APP_NOTION_LINK_DEEP_LINK=meno://notion/link
