{
  "name": "meno",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "node scripts/mobile-lan.mjs",
    "start:expo": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "node scripts/web-proxy.mjs",
    "web:proxy": "node scripts/web-proxy.mjs",
    "build:android:preview": "npm run build:android:preview:local",
    "build:android:preview:local": "mkdir -p dist && npx --yes eas-cli@latest build --platform android --profile preview --local --output ./dist/meno-preview.apk --non-interactive",
    "build:android:preview:cloud": "npx --yes eas-cli@latest build --platform android --profile preview --non-interactive",
    "build:android:production": "npx --yes eas-cli@latest build --platform android --profile production --non-interactive",
    "check:expo-config": "npx --yes expo config --type public"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-navigation/bottom-tabs": "^6.5.20",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/native-stack": "^6.9.26",
    "expo": "~54.0.35",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.11",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "babel-preset-expo": "^54.0.10"
  }
}
